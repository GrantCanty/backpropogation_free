__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
dist/
build/

# Generated experiment artifacts. Compact checked-in summaries belong in docs.
results/*.json
results/*.csv
results/*.png
results/*.pt
results/*.npz
!results/.gitkeep

# Generated artifacts retained with the archived CPAM project.
archives/cpam/results/*.json
archives/cpam/results/*.csv
archives/cpam/results/*.png
archives/cpam/results/*.pt
archives/cpam/results/*.npz
!archives/cpam/results/.gitkeep

# Keep the archived research narrative even when a local Git exclude ignores
# newly created Markdown files.
!archives/cpam/*.md
!archives/cpam/configs/*.md
!archives/cpam/docs/*.md
