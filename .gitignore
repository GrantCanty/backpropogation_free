__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
dist/
build/

# Generated experiment artifacts. Compact checked-in summaries belong in docs.
results/**/*.json
results/**/*.csv
results/**/*.png
results/**/*.pt
results/**/*.npz
!results/**/*.gitkeep

# Generated artifacts retained with the archived CPAM project.
archives/**/*.json
archives/**/*.csv
archives/**/*.png
archives/**/*.pt
archives/**/*.npz
!archives/**/*.gitkeep

# Keep the archived research narrative even when a local Git exclude ignores
# newly created Markdown files.
!archives/**/*.md
!archives/**/configs/*.md
!archives/**/docs/*.md
